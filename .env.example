# Publiczna konfiguracja projektu Supabase. Publishable key może trafić do
# przeglądarki; dostęp do danych nadal wymuszają reguły i endpointy serwera.
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_twoj_klucz

# Sekret wyłącznie dla funkcji serwerowych. Nigdy nie dodawaj go do plików JS
# ładowanych w przeglądarce ani do repozytorium.
SUPABASE_SECRET_KEY=sb_secret_twoj_klucz

# Klucz Google Gemini używany wyłącznie przez /api/chat.
GEMINI_API_KEY=twoj_klucz_api_tutaj

# Lokalnie aplikacja działa domyślnie pod tym adresem.
APP_ORIGIN=http://localhost:3000
